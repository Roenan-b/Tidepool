# Copy to .env and fill in. Never commit .env. All secrets below are placeholders.

# ---------- Database ----------
DATABASE_URL=postgres://memebot:memebot@127.0.0.1:5432/memebot
TEST_DATABASE_URL=postgres://memebot:memebot@127.0.0.1:5432/memebot_test
POSTGRES_PASSWORD=memebot

# ---------- Trading mode ----------
# Paper trading is the default. Live trading stays impossible unless this is exactly "true"
# AND the owner confirms the switch on the dashboard.
LIVE_TRADING_ENABLED=false
# Reference line on the dashboard only; the bot never chases it.
STRETCH_TARGET_USD=200
# Starting balance of the paper pool, in SOL.
PAPER_STARTING_SOL=10

# ---------- Risk Officer timing (defaults shown) ----------
RESERVATION_TTL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=30
RECONCILE_TOLERANCE_LAMPORTS=0
WITHDRAW_TIMELOCK_HOURS=24
# Stamped on every position so trades can be traced to the strategy config that made them.
CONFIG_VERSION=v1
LOG_LEVEL=info

# ---------- Engine control API (localhost only) ----------
ENGINE_API_HOST=127.0.0.1
ENGINE_API_PORT=7070
# Long random string shared with the dashboard server. Generate: openssl rand -hex 32
ENGINE_API_TOKEN=replace-with-64-hex-chars

# ---------- Risk Officer <-> signer ----------
# HMAC secret for reservation tickets, shared by engine and signer only. openssl rand -hex 32
RESERVATION_TICKET_SECRET=replace-with-64-hex-chars
SIGNER_URL=http://127.0.0.1:7071
SIGNER_HOST=127.0.0.1
SIGNER_PORT=7071
# Bearer token the engine uses to call the signer. openssl rand -hex 32
SIGNER_API_TOKEN=replace-with-64-hex-chars
# Encrypted keystore created with `npm run keystore -w @tidepool/signer -- create`.
SIGNER_KEYSTORE_PATH=./keystore/hot-wallet.keystore.json
# Passphrase is read from this env var at start only; prefer injecting it from a secrets manager.
SIGNER_KEYSTORE_PASSPHRASE=
# Signer policy caps (lamports). 1 SOL = 1000000000.
SIGNER_MAX_PER_TX_LAMPORTS=500000000
SIGNER_MAX_PER_DAY_LAMPORTS=5000000000
SIGNER_MAX_TIP_LAMPORTS=2000000
# The only address withdrawals may go to (Jake's own wallet, an on-curve address, not a token account).
# Must match the dashboard setting. Per-transaction and daily caps also apply to withdrawals.
SIGNER_WITHDRAW_ALLOWLIST=
SIGNER_STATE_PATH=./keystore/signer-state.json
# Comma-separated tip accounts copied from the Jito or Sender docs. Empty means every tip is denied.
SIGNER_TIP_ACCOUNTS=
# Extra program ids the policy may allow (comma-separated). Leave empty unless a route needs one.
SIGNER_EXTRA_PROGRAM_IDS=
SIGNER_ALLOW_NON_LOOPBACK=false
# Top-level SPL token transfers are denied by default (swaps move tokens inside the router instruction).
SIGNER_ALLOW_TOP_LEVEL_TOKEN_TRANSFERS=false
SIGNER_MAX_TICKET_TTL_MS=300000

# ---------- Solana / market data ----------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
HELIUS_WS_URL=
DEXSCREENER_BASE_URL=https://api.dexscreener.com
# Optional Helius RPC (enables holder-count growth via DAS; without it social signals can never raise a score).
HELIUS_RPC_URL=
CREATOR_BLOCKLIST_PATH=./data/creator-blocklist.json
# Comma-separated program ids the stream watches for new pools (defaults cover pump.fun and common AMMs).
SCOUT_STREAM_PROGRAMS=
SCOUT_WATCHLIST_SIZE=500
JUPITER_BASE_URL=https://api.jup.ag
JUPITER_API_KEY=
# Transaction landing: "rpc", "sender" or "jito"
LANDING_METHOD=rpc
SENDER_URL=
JITO_BLOCK_ENGINE_URL=

# ---------- Social and trend sources (all optional) ----------
LUNARCRUSH_API_KEY=
X_BEARER_TOKEN=
# Comma-separated X user IDs whose posts count as a curated signal list.
X_CURATED_USER_IDS=
X_MAX_READS_PER_HOUR=200

# ---------- Narrative classifier (optional, runs off the trading hot path) ----------
# Any endpoint that speaks the common chat completions format.
NARRATIVE_API_URL=
NARRATIVE_API_KEY=
NARRATIVE_MODEL=
NARRATIVE_MAX_CALLS_PER_HOUR=120

# ---------- Alerts ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Dashboard ----------
DASHBOARD_ORIGIN=http://127.0.0.1:3000
ENGINE_URL=http://127.0.0.1:7070
# 32-byte key, base64, for encrypting TOTP secrets at rest. openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
