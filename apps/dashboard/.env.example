# Dashboard settings. The repository root .env.example documents every variable;
# Next.js reads .env files from this directory (apps/dashboard).
DATABASE_URL=postgres://memebot:memebot@127.0.0.1:5432/memebot
ENGINE_URL=http://127.0.0.1:7070
ENGINE_API_TOKEN=replace-with-64-hex-chars
DASHBOARD_ORIGIN=http://127.0.0.1:3000
# 32-byte key, base64: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# Preview with fake data, no engine, no database, sign-in bypassed, all actions disabled.
# Never enable on a deployed server. Refused in production builds unless the origin is loopback
# and no engine token or database URL is configured.
DEMO_MODE=false
